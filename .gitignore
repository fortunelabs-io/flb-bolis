build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
warnings.txt
html_report/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets
.env
.env.*

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Prebuilt firmware images and the manifest that names their hashes: CI places
# both in the host package at release time
# (docs/adr/2026-11-10-firmware-image-carriage.md)
host/src/bolis/firmware/*.bin
host/src/bolis/firmware/manifest.json
